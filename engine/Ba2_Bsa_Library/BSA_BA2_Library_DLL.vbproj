<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <Configurations>Debug;Release;Publish</Configurations>
    <Platforms>x86;x64</Platforms>
  </PropertyGroup>

  <!-- Identidad que ve el usuario: Propiedades del archivo en Windows y el volcado de ensamblados
       de un reporte de caida. El NUMERO no esta aca: sale del Directory.Build.props del repo. -->
  <PropertyGroup>
    <Product>Bethesda BSA / BA2 Library</Product>
    <AssemblyTitle>Bethesda BSA / BA2 Library</AssemblyTitle>
    <Description>Reader and writer for Bethesda BSA (SSE) and BA2 (FO4) archives.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="BSABA2.zip" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tools/TexCodecPerfProbe: gate del zlib del writer de BA2. `CompressZlib` es `Friend` y asi se
         queda: el arnes entra por InternalsVisibleTo y la superficie distribuida no cambia.
         Ver 00-reglas-self-tests-no-van-en-el-binario. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TexCodecPerfProbe</_Parameter1>
    </AssemblyAttribute>
    <!-- Tools/BsaHashGate: compara el hash TES4 que produce ESTA lib contra los hashes que Bethesda YA
         ESCRIBIO en los BSA vanilla. Es la unica forma de que el gate PUEDA fallar: el que existia
         (ArchivePackager.vb, anti-stale) compara el hash guardado contra la funcion de la app, o sea la
         app validandose a si misma — y por eso no vio el `>= 2` donde wbHash.pas:224 dice `> 2`.
         Necesita `BsaWriter.BASTes4Hashing` (Friend). NADA se vuelve Public. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>BsaHashGate</_Parameter1>
    </AssemblyAttribute>
    <!-- Tools/ModelInfoDerivationGate: cada entrada del bloque de Model Information de un record es
         (hash del nombre, extension, hash de la carpeta) — el MISMO trio con el que un BA2 indexa. El
         gate necesita `Ba2WriterCommon.Fo4PathHash` (Friend) para poder comparar lo que deriva del NIF
         contra los bytes del record. Reimplementarlo dejaria DOS copias de la unica funcion que decide
         si una entrada apunta al archivo correcto, y la del gate no tendria por que fallar cuando la de
         la app falle. NADA se vuelve Public. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ModelInfoDerivationGate</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!-- SSE Animation Previewer: the native DDS wrapper is linked prebuilt from lib\, so this builds with the
         .NET SDK alone. Its source is in native\DirectXTextWrapper; see docs\building.md to rebuild it. -->
    <Reference Include="DirectXTexWrapper"><HintPath>$(MSBuildThisFileDirectory)..\..\lib\DirectXTexWrapper.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>
   <!-- Fija la plataforma del wrapper NATIVO. Va en LOS SEIS proyectos, no solo en los dos que lo
       referencian de verdad: el SDK inyecta el ProjectReference transitivo sin la metadata. Ver el .targets. -->

  <!-- La configuracion Publish: es Release con carpeta propia. Sin esto compilaria SIN
       OPTIMIZAR, en verde. Ver el comentario del .targets. -->
  <Import Project="..\FO4_Base_Library\ConfiguracionPublish.targets" />
</Project>