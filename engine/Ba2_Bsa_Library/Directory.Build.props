<Project>

  <!-- IDENTIDAD DE LOS ENSAMBLADOS DE ESTE REPO. La explicacion completa (por que aca y no en la raiz del
       arbol, que deriva cada campo, y por que el numero solo NO alcanza) esta en
       ..\FO4_Base_Library\Directory.Build.props, al lado de Shared\VersionGate.vb, que es quien avisa.

       El numero es de ESTE repo. Este DLL lo consumen Ba2_Bsa_Manager y Nif_Explorer, que son repos
       distintos: si se actualiza uno solo, la mezcla la caza VersionGate del exe.

       `<Version>` es la unica perilla: de ella salen AssemblyVersion (la identidad de binding que se hornea
       en el AssemblyRef de quien compile contra esto), FileVersion y InformationalVersion. -->

  <PropertyGroup>
    <Version>2.3.5</Version>
    <Company>MANOLOV02</Company>
    <Copyright>Copyright (c) 2026 MANOLOV02</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
