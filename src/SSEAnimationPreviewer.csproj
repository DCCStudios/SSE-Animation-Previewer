<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <SelfContained>true</SelfContained><PublishSingleFile>false</PublishSingleFile><PublishTrimmed>false</PublishTrimmed><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>SSE Animation Previewer</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Build output goes to bin\ at the repository root, where the tests look for fixtures four folders up. -->
    <BaseOutputPath>..\bin\</BaseOutputPath>
    <FloorTextures Condition="'$(FloorTextures)'=='' And Exists('resources\local\testgrid_d.dds')">resources\local</FloorTextures>
    <FloorTextures Condition="'$(FloorTextures)'==''">resources</FloorTextures>
  </PropertyGroup>
  <ItemGroup>
    <!-- SetConfiguration keeps the engine in the previewer's configuration when building through the solution,
         which would otherwise build it as Debug.
         The engine builds from source in engine\. Its one native part, the DDS wrapper, is prebuilt in lib\. -->
    <ProjectReference Include="..\engine\FO4_Base_Library\FO4_Base_Library.vbproj" SetConfiguration="Configuration=$(Configuration)" SetPlatform="Platform=x64" />
    <ProjectReference Include="..\engine\FO4_Base_Library\FO4_Base_Library_CSharpHelpers\FO4_Base_Library_CSharpHelpers.csproj" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="..\engine\Ba2_Bsa_Library\BSA_BA2_Library_DLL.vbproj" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="..\engine\Material-Editor-master\MaterialLib\MaterialLib.csproj" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="..\engine\NiflySharp\NiflySharp\NiflySharp.csproj" SetConfiguration="Configuration=$(Configuration)" />
    <Reference Include="DirectXTexWrapper"><HintPath>..\lib\DirectXTexWrapper.dll</HintPath></Reference>
    <None Include="..\lib\Ijwhost.dll" Link="Ijwhost.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- Floor textures: the generated set in resources, or your own set in resources\local (not in the repository). -->
    <None Include="$(FloorTextures)\testgrid_*.dds" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="miniball-devel0" Version="1.0.4" />
    <PackageReference Include="BulletSharp.x64" Version="0.12.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
