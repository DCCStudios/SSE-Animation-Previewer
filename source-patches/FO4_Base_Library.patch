+    ''' <summary>Creates generation-stamped locations for an external archive index.
+    ''' The host owns overlay precedence; absolute archive paths keep same-named mod archives distinct.</summary>
+    ''' <summary>Releases idle handles for one archive. Active reads finish normally and
+    ''' are discarded on return. Call only while the host has stopped asset loading before replacing a file.</summary>
+    Public Shared Sub ReleaseExternalArchiveReaders(archivePath As String)
+        Dim key = ArchiveKey(Path.GetFullPath(archivePath))
+        BumpArchiveEpoch(key)
+        DrainAndDisposeBag(key)
+    End Sub
+    Public Shared Function BuildExternalArchiveLocations(archivePath As String,
+            entries As IEnumerable(Of KeyValuePair(Of String, Integer)),
+            sourceOrder As Integer) As Dictionary(Of String, File_Location)
+        Dim absolutePath = Path.GetFullPath(archivePath)
+        If Not File.Exists(absolutePath) Then Throw New FileNotFoundException("Archive not found", absolutePath)
+        Dim fileDate = File.GetLastWriteTime(absolutePath)
+        Dim result As New Dictionary(Of String, File_Location)(StringComparer.OrdinalIgnoreCase)
+        SyncLock _overriddenEntriesLock
+            ReleaseExternalArchiveReaders(absolutePath)
+            Dim token = ContentGenTokenOf(absolutePath)
+            Dim generation = Threading.Interlocked.Increment(token.Gen)
+            ClearBytesCache()
+            For Each entry In entries
+                result(entry.Key) = New File_Location With {
+                    .FullPath = entry.Key, .BA2File = absolutePath, .Index = entry.Value,
+                    .SourceOrder = sourceOrder, .FileDate = fileDate,
+                    .ArchiveGen = generation, .GenToken = token
+                }
+            Next
+        End SyncLock
+        Return result
+    End Function
