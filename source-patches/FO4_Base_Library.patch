+    Private Function SampleStoredTrack(track As Integer, t As Single) As Single()
+        Dim frame = Math.Clamp(t / Math.Max(0.000001F, _animation.FrameDuration), 0, _animation.NumFrames - 1)
+        Dim low = CInt(Math.Floor(frame))
+        Dim high = Math.Min(low + 1, _animation.NumFrames - 1)
+        Dim a = _animation.GetTransform(low, track)
+        Dim b = _animation.GetTransform(high, track)
+        If a Is Nothing OrElse b Is Nothing Then Return Nothing
+        Dim u = CSng(frame - low)
+        Dim result(11) As Single
+        For i = 0 To 11
+            result(i) = a(i) + (b(i) - a(i)) * u
+        Next
+        Dim q = System.Numerics.Quaternion.Slerp(New System.Numerics.Quaternion(a(4), a(5), a(6), a(7)), New System.Numerics.Quaternion(b(4), b(5), b(6), b(7)), u)
+        result(4) = q.X : result(5) = q.Y : result(6) = q.Z : result(7) = q.W
+        Return result
+    End Function
