+    Public Function ParseInterleavedAnimation(source As HkxVirtualObjectGraph_Class) As HkxAnimacionDescomprimida_Class
+        If source Is Nothing OrElse source.ClassName <> "hkaInterleavedUncompressedAnimation" Then Return Nothing
+        Dim raw = Havok.Canon.Objects.HkObj_HkaInterleavedUncompressedAnimation.Read(Me, source)
+        Dim tracks = raw.NumberOfTransformTracks
+        If tracks <= 0 OrElse raw.Transforms.Count Mod tracks <> 0 Then Throw New IO.InvalidDataException("Invalid interleaved track count")
+        Dim frames = raw.Transforms.Count \ tracks
+        Dim result As New HkxAnimacionDescomprimida_Class With {
+            .Animacion = Havok.Canon.Objects.HkObj_HkaAnimation.Read(Me, source),
+            .NumFrames = frames,
+            .FrameDuration = If(frames > 1, raw.Duration / (frames - 1), raw.Duration)
+        }
+        For Each transform In raw.Transforms
+            result.TrackTransforms.Add(transform)
+            result.TrackMask.Add(127)
+        Next
